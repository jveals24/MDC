<script>
  window.populatePickupOptions = function() {
    const select = document.getElementById('PickupDaySelect');
    if (!select) return;

    const savedValue = select.dataset.currentValue || window._currentPickupDate || '';
    select.innerHTML = '<option value="">Select a pickup day...</option>';

    const blackoutDates = [
      '2026-11-26', // Thanksgiving
      '2026-11-27', // Black Friday
      '2026-12-25', // Christmas
    ];

    const now = new Date();
    // 24-hour advance notice requirement
    const minAvailableTime = new Date(now.getTime() + (24 * 60 * 60 * 1000));
    const validDays = [4, 5, 6]; // 4 = Thu, 5 = Fri, 6 = Sat
    let optionsAdded = 0;
    let checkDate = new Date(minAvailableTime);

    for (let i = 0; i < 21 && optionsAdded < 4; i++) {
      const dayOfWeek = checkDate.getDay();
      const year = checkDate.getFullYear();
      const month = String(checkDate.getMonth() + 1).padStart(2, '0');
      const day = String(checkDate.getDate()).padStart(2, '0');
      const dateKey = `${year}-${month}-${day}`;

      if (validDays.includes(dayOfWeek) && !blackoutDates.includes(dateKey)) {
        const dateString = checkDate.toLocaleDateString('en-US', {
          weekday: 'short',
          month: 'short',
          day: 'numeric'
        });

        const optValue = `${dateString} (4-6 PM)`;
        const opt = document.createElement('option');
        opt.value = optValue;
        opt.textContent = `${dateString} (4:00 PM – 6:00 PM)`;

        if (savedValue && savedValue === optValue) {
          opt.selected = true;
        }

        select.appendChild(opt);
        optionsAdded++;
      }
      checkDate.setDate(checkDate.getDate() + 1);
    }
  };

  // GLOBAL DELEGATION: Catches change events and updates the cart session
  document.addEventListener('change', function(e) {
    if (e.target && e.target.id === 'PickupDaySelect') {
      const selectedVal = e.target.value;
      window._currentPickupDate = selectedVal;
      e.target.dataset.currentValue = selectedVal;

      const formData = new URLSearchParams();
      formData.append('attributes[Pickup Date]', selectedVal);

      fetch('/cart/update.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded',
          'X-Requested-With': 'XMLHttpRequest'
        },
        body: formData.toString()
      })
      .then(response => {
        if (!response.ok) throw new Error('Network response was not ok');
        return response.json();
      })
      .then(cart => {
        console.log('Cart Attributes Saved:', cart.attributes);
      })
      .catch(err => {
        console.error('Failed to update cart attribute:', err);
      });
    }
  });

  // Re-run population on page load and cart lifecycle events
  document.addEventListener('DOMContentLoaded', window.populatePickupOptions);
  document.addEventListener('cart:updated', window.populatePickupOptions);

  // Watch for drawer open class changes
  const cartDrawerEl = document.querySelector('cart-drawer');
  if (cartDrawerEl) {
    const drawerObserver = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        if (mutation.attributeName === 'class' && cartDrawerEl.classList.contains('active')) {
          window.populatePickupOptions();
        }
      });
    });
    drawerObserver.observe(cartDrawerEl, { attributes: true });
  }

  // Fallback observer watching child additions
  const bodyObserver = new MutationObserver(() => {
    const select = document.getElementById('PickupDaySelect');
    if (select && select.options.length <= 1) {
      window.populatePickupOptions();
    }
  });
  bodyObserver.observe(document.body, { childList: true, subtree: true });

  // Deep-link directly to the Pick up checkout tab if a date is selected
  document.addEventListener('click', function(e) {
    const checkoutBtn = e.target.closest('[name="checkout"], .cart__checkout-button');
    if (!checkoutBtn) return;

    const select = document.getElementById('PickupDaySelect');
    if (select && select.value && select.value !== '') {
      e.preventDefault();
      window.location.href = '/checkout?show_pick_up=true';
    }
  });
</script>