            <line x1="2" y1="12" x2="9" y2="12"></line>
            <line x1="15" y1="12" x2="22" y2="12"></line>
            <line x1="4.93" y1="19.07" x2="9.17" y2="14.83"></line>
            <line x1="14.83" y1="9.17" x2="19.07" y2="4.93"></line>
          </svg>
        </div>

        <h3 class="ai-how-it-works-step-heading-{{ ai_gen_id }}">{{ block.settings.step_2_heading }}</h3>
        <p class="ai-how-it-works-step-text-{{ ai_gen_id }}">{{ block.settings.step_2_text }}</p>

        <div class="ai-how-it-works-thumbnails-{{ ai_gen_id }}">
          {% if block.settings.cookie_image_1 %}
