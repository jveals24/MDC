        <div class="ai-how-it-works-eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow }}</div>
      {% endif %}
      
      {% if block.settings.heading != blank %}
        <h2 class="ai-how-it-works-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}
      
      {% if block.settings.subheading != blank %}
        <p class="ai-how-it-works-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
      {% endif %}
    </div>

    <div class="ai-how-it-works-steps-{{ ai_gen_id }}">
      <div class="ai-how-it-works-step-{{ ai_gen_id }}">
        <div class="ai-how-it-works-step-number-{{ ai_gen_id }}">1</div>
        
        <div class="ai-how-it-works-icon-wrapper-{{ ai_gen_id }}">
          <svg class="ai-how-it-works-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
            <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
            <line x1="12" y1="22.08" x2="12" y2="12"></line>
          </svg>
        </div>

        <h3 class="ai-how-it-works-step-heading-{{ ai_gen_id }}">{{ block.settings.step_1_heading }}</h3>
        <p class="ai-how-it-works-step-text-{{ ai_gen_id }}">{{ block.settings.step_1_text }}</p>

        <div class="ai-how-it-works-pills-{{ ai_gen_id }}">
          <span class="ai-how-it-works-pill-{{ ai_gen_id }}">📦 {{ block.settings.pill_1_text }}</span>
          <span class="ai-how-it-works-pill-{{ ai_gen_id }}">📦 {{ block.settings.pill_2_text }}</span>
          <span class="ai-how-it-works-pill-{{ ai_gen_id }}">📦 {{ block.settings.pill_3_text }}</span>
        </div>

        <svg class="ai-how-it-works-arrow-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </div>

      <div class="ai-how-it-works-step-{{ ai_gen_id }}">
        <div class="ai-how-it-works-step-number-{{ ai_gen_id }}">2</div>
        
        <div class="ai-how-it-works-icon-wrapper-{{ ai_gen_id }}">
          <svg class="ai-how-it-works-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
