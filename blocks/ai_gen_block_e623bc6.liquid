          {% if block.settings.cookie_image_2 %}
            <div class="ai-how-it-works-thumbnail-{{ ai_gen_id }}">
              <img src="{{ block.settings.cookie_image_2 | image_url: width: 100 }}" alt="Cookie flavor" loading="lazy" width="50" height="50">
            </div>
          {% endif %}
          {% if block.settings.cookie_image_3 %}
            <div class="ai-how-it-works-thumbnail-{{ ai_gen_id }}">
              <img src="{{ block.settings.cookie_image_3 | image_url: width: 100 }}" alt="Cookie flavor" loading="lazy" width="50" height="50">
            </div>
          {% endif %}
          {% if block.settings.cookie_image_4 %}
            <div class="ai-how-it-works-thumbnail-{{ ai_gen_id }}">
              <img src="{{ block.settings.cookie_image_4 | image_url: width: 100 }}" alt="Cookie flavor" loading="lazy" width="50" height="50">
            </div>
          {% endif %}
        </div>

        {% if block.settings.flavors_link != blank %}
          <a href="{{ block.settings.flavors_link }}" class="ai-how-it-works-link-{{ ai_gen_id }}">{{ block.settings.flavors_link_text }}</a>
        {% endif %}

        <svg class="ai-how-it-works-arrow-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </div>

      <div class="ai-how-it-works-step-{{ ai_gen_id }}">
        <div class="ai-how-it-works-step-number-{{ ai_gen_id }}">3</div>
        
